# Set camera parameters
CAMERA_WIDTH = 1920
CAMERA_HEIGHT = 1080
CAMERA_QUALITY = 90
CAMERA_FRAMERATE = 30

# Capture Image Function with Error Handling
def capture_image():
    try:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        image_path = os.path.join(CAPTURED_RAW_DIR, f"{timestamp}.jpg")

        print("📸 Capturing image...")
        
        # Use libcamera-still for more stable capture on Raspberry Pi
        capture_command = f"libcamera-still -o {image_path} --width {CAMERA_WIDTH} --height {CAMERA_HEIGHT} --quality {CAMERA_QUALITY} --framerate {CAMERA_FRAMERATE}"
        
        result = os.system(capture_command)
        if result != 0:
            raise Exception("Failed to capture image with libcamera.")

        # Check if the image was saved
        if not os.path.exists(image_path):
            raise Exception("Error: Image file not saved.")

        print(f"Image captured and saved to {image_path}")
        return image_path, timestamp
    except Exception as e:
        print(f"Error capturing image: {e}")
        return None, None

# Firebase upload function
def upload_image(image_path, image_type, timestamp):
    try:
        with open(image_path, "rb") as image_file:
            image_data = base64.b64encode(image_file.read()).decode('utf-8')

        firebase_path = f"detections/{timestamp}/{image_type}"
        ref = db.reference(firebase_path)
        ref.set(image_data)
        print(f"Uploaded {image_path} to Firebase under {firebase_path}")
    except Exception as e:
        print(f"Error uploading {image_path}: {e}")

# Main loop for continuous image capture and processing
while True:
    raw_image_path, timestamp = capture_image()
    if raw_image_path:
        # Process image (additional logic for detection and uploading will go here)
        # You can integrate your pest detection, growth parameters, etc.
        print("Running image processing...")

        # Example: Upload raw image to Firebase
        upload_image(raw_image_path, "Raw", timestamp)

    cont = input("\nPress Enter to capture again or type 'q' to quit: ")
    if cont.lower() == 'q':
        break
